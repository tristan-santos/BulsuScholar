# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_STORAGE_BUCKET=bulsuscholar

# Supabase Auth / App
VITE_APP_URL=https://bulsuscholar.com
VITE_PASSWORD_SECRET=change-this-secret

# Optional auth verification:
# AUTH_TEST_USER_ID=
# AUTH_TEST_PASSWORD=
# AUTH_TEST_RESET_USER_ID=
# AUTH_TEST_SEND_RESET=false

# Python document scanner backend
# Required for production builds. Development defaults to http://127.0.0.1:8000.
VITE_BACKEND_API_URL=https://api.bulsuscholar.com
# Optional override; when omitted, document scanning uses VITE_BACKEND_API_URL.
VITE_DOCUMENT_SCAN_API_URL=https://api.bulsuscholar.com

# Hosting / Domain Notes
VITE_PUBLIC_SITE_URL=https://bulsuscholar.com

# Optional backend-only Help Assistant. When omitted, the controlled FAQ fallback remains available.
# Configure these on Railway, never as VITE_ variables in Vercel.
OPENAI_API_KEY=
OPENAI_HELP_MODEL=gpt-5-mini

# Python backend only. Configure these in Railway, never in Vercel.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FRONTEND_URL=https://bulsuscholar.com
DOCUMENT_SCAN_ALLOWED_ORIGINS=https://bulsuscholar.com
DOCUMENT_SCAN_ALLOWED_ORIGIN_REGEX=
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_NAME=BulsuScholar
BREVO_SENDER_EMAIL=no-reply@bulsuscholar.com
BREVO_REPLY_TO_EMAIL=support@bulsuscholar.com
ENFORCE_PORTAL_ACTOR_HEADERS=true
# Enable after every normal administrator has a Supabase Auth identity.
ENFORCE_ADMIN_JWT=false
WEB_CONCURRENCY=1
UVICORN_KEEP_ALIVE=30

# Root administration. Keep every value below on Railway only.
# Use a random value of at least 32 characters for ROOT_SESSION_SECRET.
ROOT_SESSION_SECRET=
ROOT_ADMIN_USER_ID=Tristan@Root
ROOT_ADMIN_EMAIL=santostristan326@gmail.com
# Supply the fixed root password only while running the trusted setup script.
ROOT_ADMIN_FIXED_PASSWORD=
# Supabase Connect > Session pooler URL with sslmode=require.
ROOT_DATABASE_URL=
RAILWAY_PROJECT_TOKEN=
RAILWAY_SERVICE_ID=
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# A protected Vercel Deploy Hook is used for the explicit redeploy action.
VERCEL_DEPLOY_HOOK_URL=
# Enable only after the choice migration, legacy audit, and backend deployment.
ENABLE_SCHOLARSHIP_CHOICE=true
VITE_ENABLE_SCHOLARSHIP_CHOICE=true


SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=your_brevo_login
SMTP_PASSWORD=your_smtp_key
