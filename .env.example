# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_STORAGE_BUCKET=bulsuscholar

# Supabase Auth / App
VITE_APP_URL=https://bulsu-scholar.vercel.app
VITE_PASSWORD_SECRET=change-this-secret

# Optional auth verification:
# AUTH_TEST_USER_ID=
# AUTH_TEST_PASSWORD=
# AUTH_TEST_RESET_USER_ID=
# AUTH_TEST_SEND_RESET=false

# Resend Email
# Keep RESEND_API_KEY server-side only in the Python backend. Do not prefix it with VITE_.
VITE_RESEND_API_ENDPOINT=https://bulsuscholar.onrender.com/email/send
RESEND_API_KEY=
RESEND_FROM_EMAIL=BulsuScholar <onboarding@resend.dev>

# Python document scanner backend
VITE_BACKEND_API_URL=https://bulsuscholar.onrender.com
VITE_DOCUMENT_SCAN_API_URL=https://bulsuscholar.onrender.com

# Hosting / Domain Notes
VITE_PUBLIC_SITE_URL=https://bulsu-scholar.vercel.app

# Optional backend-only Help Assistant. When omitted, the controlled FAQ fallback remains available.
# Configure these on Render/Railway, never as VITE_ variables in Vercel.
OPENAI_API_KEY=
OPENAI_HELP_MODEL=gpt-5-mini

# Python backend only. Configure these in Render/Railway, never in Vercel.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FRONTEND_URL=https://bulsu-scholar.vercel.app
DOCUMENT_SCAN_ALLOWED_ORIGINS=https://bulsu-scholar.vercel.app
DOCUMENT_SCAN_ALLOWED_ORIGIN_REGEX=
ENFORCE_PORTAL_ACTOR_HEADERS=true
WEB_CONCURRENCY=1
UVICORN_KEEP_ALIVE=30

# Enable only after the choice migration, legacy audit, and backend deployment.
ENABLE_SCHOLARSHIP_CHOICE=true
VITE_ENABLE_SCHOLARSHIP_CHOICE=true
