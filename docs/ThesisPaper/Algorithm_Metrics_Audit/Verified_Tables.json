    "rows": [
      [
        "[S] Student identity/name matching (signup roster)",
        "Custom normalized Levenshtein + token overlap",
        "S=1-d/max(lengths). Match if direct S>=.72 OR sorted S>=.72 OR (same last token AND overlap>=.5).",
        ".72 and .5: hardcoded. Missing/equal names pass this helper.",
        "Different-name same-ID roster can be reported as identity conflict; this helper is not official award authorization.",
        "backend/signup_service.py:485-508 (levenshtein_similarity); backend/signup_service.py:549-562 (is_similar_roster_name)"
      ],
      [
        "[S] Browser ROG-to-COR identity comparison",
        "Custom DP + token overlap + 2-factor weighted score",
        "n=max(sorted-name S, token overlap); i=1 only for exact digit-only ID; Q=round(.75i+.25n,4).",
        "ID exact required; when both names exist Q>=.85 AND n>=.70. All hardcoded. Missing-name path skips name gate.",
        "Returns passed/canValidate metadata. Current caller logs failure as inconclusive; it does not reject on this result.",
        "src/pages/SignupPage.jsx:585-697 (validateCogIdentity); src/pages/SignupPage.jsx:981-1093 (scanUploadedDocument)"
      ],
      [
        "[S] Fuzzy record comparison",
        "Custom Levenshtein and direct/token-sorted name maximum",
        "n=max(S(nameA,nameB), S(sortTokens(nameA),sortTokens(nameB))).",
        "No global scalar-helper threshold. Branches below define decisions; missing field comparisons return None.",
        "Computes text similarity before exact flags; not restricted to missing/different IDs.",
        "backend/grantor_algorithms.py:32-56 (levenshtein_similarity); backend/grantor_algorithms.py:59-65 (comparable_similarity); backend/grantor_algorithms.py:68-123 (evaluate_scholar_duplicate)"
      ],
      [
        "[S] Weighted record linkage",
        "Eight-field available-weight normalized sum",
        "W=sum(w_i*s_i)/sum(w_i), only values not None; W=0 if included weight=0.",
        "Name >=.82 AND W>=.84 for general pair rule. Both hardcoded; exact/contact alternatives can bypass.",
        "Possible duplicate flag, not proof of one student or scholarship commitment.",
        "backend/grantor_algorithms.py:68-123 (evaluate_scholar_duplicate)"
      ],
      [
        "[S] Strong identifier/contact pair rules",
        "Exact normalized ID/email and digit-only phone + name",
        "duplicate = exactID OR ((exactEmail OR exactPhone) AND n>=.72) OR (n>=.82 AND W>=.84).",
        "Exact ID has no numeric score floor; .72 hardcoded. Field reason-label threshold .90 is not a duplicate gate.",
        "Same ID can flag despite different names; unequal IDs can still flag through the fuzzy branch.",
        "backend/grantor_algorithms.py:68-123 (evaluate_scholar_duplicate)"
      ],
      [
        "[S] Admin duplicate grouping",
        "Greedy grouping using pair flag OR score-only comparison",
        "Join first group if any member: pair.isDuplicate OR pair.score>=T.",
        "T=float(options.get(\"threshold\") or .84): dynamic parameter, default hardcoded .84. Numeric zero falls back.",
        "Score-only grouping may bypass .82 name floor. No built-in probable/uncertain tier or validated T range.",
        "backend/grantor_algorithms.py:206-262 (check_student_table_duplicates)"
      ],
      [
        "[S] Legacy/admin linkage helper",
        "Exact ID, otherwise normalized name parts AND shared address",
        "Exact lookup key OR match_name_parts AND match_address. Missing middle initial tolerated.",
        "Exact Boolean rules; no Levenshtein cutoff. Admin lookup takes first suitable fallback.",
        "Relationship/lookup output; not the current authoritative award transaction.",
        "backend/grantor_algorithms.py:326-333 (matches_grantor_scholar_to_student); backend/grantor_algorithms.py:366-396 (match_admin_grantor_students)"
      ],
      [
        "[S] Current roster import identity",
        "Exact explicit IDs; exact canonical profile if either ID absent",
        "Both IDs present: ID equality. Otherwise exact (name, canonical course, normalized year) tuple equality.",
        "No fuzzy threshold. Latest profile normalization from Oct 26 migration; missing profile field prevents match.",
        "Same-cycle active cross-grantor matches block import. No-ID rows stay unlinked and do not authorize an account award.",
        "backend/roster_workflow_service.py:141-146 (_same_roster_identity); supabase/migrations/20261026043502_manual_roster_name_and_course_matching.sql:3-32 (roster_import_profile_key); supabase/migrations/20261026034945_cross_grantor_roster_identity_guard.sql:16-24 (roster_import_matches)"
      ],
      [
        "[S] Duplicate scholarship conflict prevention",
        "Stored identity/program/cycle/commitment rules, transaction locks",
        "Exact stored student ID and normalized full name; current cycle; recognized active program/provider; no competing live award/commitment.",
        "No similarity threshold. Current cycle is configured; unknown-cycle active legacy rows require resolution.",
        "Named blocker/exception prevents conflicting assignment/application. Full Admin resolution requires role and reason.",
        "supabase/migrations/20261023070747_solis_cycle_aware_roster_reconciliation.sql:69-194 (assign_authoritative_roster_scholarship); supabase/migrations/20261023070747_solis_cycle_aware_roster_reconciliation.sql:447-474 (roster_application_blocker); backend/roster_workflow_service.py:520-542 (resolve_roster_conflict)"
      ],
      [
        "[S] COR extraction and validation",
        "pdfplumber + field regex/layout; optional local OCR fallback",
        "Extract labelled identity/course/year/section/GWA/period. Signup compares exact COR ID and current period; title/policy/year checks.",
        "No OCR/Levenshtein confidence threshold. Current cycle and corMode configured. File limit 10 MiB.",
        "Reject invalid title/ID/cycle or missing usable year in signup batch. Profile replacements do not repeat all those checks.",
        "backend/document_scanner.py:926-970 (parse_pdf_document); backend/signup_service.py:172-306 (create_signup_document_batch); backend/student_profile_service.py:885-967 (upload_student_document)"
      ],
      [
        "[S] ROG extraction and validation",
        "Table -> positioned-word -> text grade extraction + title/period rules",
        "Read printed GWA; flag Final 4/5, INC/UD/OD or Failed remarks. Signup requires prior period unless exempt.",
        "No OCR confidence threshold. Concern tokens hardcoded; prior cycle derived. Browser Q gates are distinct and currently advisory.",
        "Reject wrong title/period/concerns in signup batch. ROG owner check is not enforced there; profile upload principally checks title.",
        "backend/document_scanner.py:458-531 (extract_final_grades_from_pdf_tables); backend/document_scanner.py:534-658 (extract_final_grades_from_pdf_words); backend/document_scanner.py:661-731 (extract_final_grades_from_text); backend/signup_service.py:172-306 (create_signup_document_batch)"
      ]
    ]
