  W4G --> W4E
  W4B[/"Block scholar edit and show duplicate message"/]
  W4B --> W4E
  W4N[/"Keep ordinary list display or allow edit to continue"/]
  W4N --> W4E
  W4E(["End duplicate check; no historical-row deletion"])
  W4A1["Reference: Weighted Record Linkage / Levenshtein"]
