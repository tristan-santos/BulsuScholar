  W6R -->|"NO"| W6X
  W6X[/"Return error; preserve unresolved conflict"/]
  W6X --> W6E
  W6O[/"Return no assignment, assigned or unchanged state"/]
  W6O --> W6E
  W6E(["End reconciliation/resolution"])
  W6A1["Reference: Exact official identity, cycle and commitment guards"]
  W6D -. "uses" .-> W6A1
